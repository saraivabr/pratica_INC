{
  "name": "pratica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && tsc -p tsconfig.server.json",
    "dev": "next dev",
    "dev:all": "sh scripts/run-dev.sh",
    "lint": "eslint .",
    "start": "next start",
    "whatsapp:worker": "node services/whatsapp-worker/worker.mjs",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:build": "cap sync android && cd android && ./gradlew assembleDebug",
    "cap:build:release": "cap sync android && cd android && ./gradlew assembleRelease",
    "test": "vitest",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:security": "vitest run __tests__/security",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:server": "tsc -p tsconfig.server.json",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "node dist/server/server/index.js",
    "build:all": "pnpm run build && pnpm run build:server",
    "rag:index": "tsx scripts/rag-index.ts",
    "rag:setup": "tsx scripts/rag-setup.ts",
    "rag:migrate": "tsx scripts/rag-migrate.ts",
    "postinstall": "pnpm run build:all || true"
  },
